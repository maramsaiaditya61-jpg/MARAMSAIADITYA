"""
thermal_model.py
Lumped-mass thermal model for a battery pack:
heat generated by I^2*R0 Joule heating, lost via convection to ambient.
"""


class ThermalModel:
    def __init__(self, mass_kg=0.048, specific_heat=900.0, ambient_C=25.0,
                 h_conv=5.0, area_m2=0.0035):
        """
        mass_kg      : thermal mass of the pack/cell (kg)
        specific_heat: J/(kg*K)
        ambient_C    : ambient temperature (deg C)
        h_conv       : convective heat transfer coefficient (W/m^2K)
        area_m2      : surface area for convection (m^2)
        """
        self.T = ambient_C
        self.ambient = ambient_C
        self.mass = mass_kg
        self.cp = specific_heat
        self.h = h_conv
        self.area = area_m2

    def update(self, current_A, R0, dt_s):
        q_gen = (current_A ** 2) * R0
        q_loss = self.h * self.area * (self.T - self.ambient)
        dT = (q_gen - q_loss) * dt_s / (self.mass * self.cp)
        self.T += dT
        return self.T
