   "id": "d12906ad",
   "metadata": {},
   "outputs": [],
   "source": [
    "axes[2].plot(df[\"time_s\"], df[\"ice_torque_Nm\"], label=\"ICE torque (Nm)\")\n",
    "axes[2].plot(df[\"time_s\"], df[\"motor_torque_Nm\"], label=\"Motor torque (Nm)\")\n",
    "axes[2].set_ylabel(\"Torque (Nm)\")\n",
    "axes[2].set_xlabel(\"Time (s)\")\n",
    "axes[2].legend()\n",
    "axes[2].set_title(\"Torque Distribution\")"
   ]
  },
  {
