   "id": "359b186d",
   "metadata": {},
   "outputs": [],
   "source": [
    "axes[1].plot(df[\"time_s\"], df[\"ice_power\"]/1000, label=\"ICE power (kW)\")\n",
    "axes[1].plot(df[\"time_s\"], df[\"motor_power\"]/1000, label=\"Motor power (kW)\")\n",
    "axes[1].set_ylabel(\"Power (kW)\")\n",
    "axes[1].legend()\n",
    "axes[1].set_title(\"Power Split\")"
   ]
  },
  {
   "cell_type": "code",
