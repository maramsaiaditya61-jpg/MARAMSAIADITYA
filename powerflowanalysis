   "id": "19b36847",
   "metadata": {},
   "outputs": [],
   "source": [
    "axes[0].plot(df[\"time_s\"], df[\"speed_kmh\"])\n",
    "axes[0].set_ylabel(\"Speed (km/h)\")\n",
    "axes[0].set_title(\"Driving Cycle\")"
   ]
  },
  {
   "cell_type": "code",
