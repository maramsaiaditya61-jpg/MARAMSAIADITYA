   "source": [
    "# -----------------------------------------------------------------------\n",
    "# 10. Simple optimization: sweep EV_THRESHOLD to minimize fuel while\n",
    "#     keeping battery net energy change >= -0.05 kWh (avoid excessive drain)\n",
    "# -----------------------------------------------------------------------\n",
    "def simulate(threshold_W):\n",
    "    d = df.copy()\n",
    "    def split(p):\n",
    "        if p <= 0:\n",
    "            return 0, p\n",
    "        if p <= threshold_W:\n",
    "            return 0, min(p, MOTOR_MAX_POWER)\n",
    "        ice = min(p, ICE_MAX_POWER)\n",
    "        mot = min(max(0, p - ice), MOTOR_MAX_POWER)\n",
    "        return ice, mot\n",
    "    ice_p, mot_p = zip(*d[\"power_demand_W\"].apply(split))\n",
    "    fuel_L = (np.array(ice_p) / ICE_EFF / FUEL_ENERGY_DENSITY).sum()\n",
    "    batt_change = np.where(d[\"power_demand_W\"] <= 0,\n",
    "                            np.array(mot_p) * MOTOR_EFF,\n",
    "                            -np.array(mot_p) / MOTOR_EFF).sum()\n",
    "    return fuel_L, batt_change / 3.6e6  # L, kWh"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "dcd409ec",
   "metadata": {},
   "outputs": [],
   "source": [
    "thresholds = np.arange(0, 40_000, 2000)\n",
    "sweep = [simulate(th) for th in thresholds]\n",
    "sweep_df = pd.DataFrame(sweep, columns=[\"fuel_L\", \"battery_kWh\"])\n",
    "sweep_df[\"threshold_kW\"] = thresholds / 1000"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "43348912",
   "metadata": {},
   "outputs": [],
   "source": [
    "valid = sweep_df[sweep_df[\"battery_kWh\"] >= -0.05]\n",
    "best = valid.loc[valid[\"fuel_L\"].idxmin()] if not valid.empty else sweep_df.loc[sweep_df[\"fuel_L\"].idxmin()]\n",
    "print(f\"\\nOptimal EV threshold: {best['threshold_kW']:.1f} kW \"\n",
    "      f\"-> fuel {best['fuel_L']:.3f} L, battery change {best['battery_kWh']:.4f} kWh\")"
   ]
  }
