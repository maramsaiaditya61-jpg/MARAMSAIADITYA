"""
load_profiles.py
Generates test current profiles for discharging the pack:
constant current, step load, and a synthetic driving-cycle-like profile.
"""

import numpy as np


def constant_current(duration_s, dt_s, value_A):
    n = int(duration_s / dt_s)
    return np.full(n, value_A)


def step_profile(duration_s, dt_s, steps):
    """steps: list of (segment_duration_s, current_A) tuples"""
    profile = []
    for dur, val in steps:
        n = int(dur / dt_s)
        profile.extend([val] * n)
    return np.array(profile)


def synthetic_driving_cycle(duration_s, dt_s, base_A=2.0, seed=42):
    """A stand-in for a real EV driving-cycle current trace (e.g. from the
    EV Driving Cycle Kaggle dataset). Replace with real current data if you
    load an actual dataset (see README)."""
    rng = np.random.default_rng(seed)
    n = int(duration_s / dt_s)
    t = np.linspace(0, duration_s, n)
    profile = base_A + 1.5 * np.sin(2 * np.pi * t / 120) + rng.normal(0, 0.3, n)
    return profile
