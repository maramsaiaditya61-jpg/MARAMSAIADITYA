    return;
  }
  // create file and header if not exists
  if (!SD.exists(LOG_FILE_NAME)) {
    logFile = SD.open(LOG_FILE_NAME, FILE_WRITE);
    if (logFile) {
      logFile.println("timestamp_ms,Vpanel(V),Ipanel(A),Ppanel(W),Vbat(V),soc,duty,throttle");
      logFile.flush();
      logFile.close();
    }
  }
}

void appendLog(unsigned long tms, float Vp, float Ip, float Pp, float Vbat, float soc, float duty, float throttle) {
  if (!SD.begin(SD_CS)) {
    // do nothing if SD fails
    return;
  }
  logFile = SD.open(LOG_FILE_NAME, FILE_APPEND);
  if (logFile) {
    logFile.print(tms); logFile.print(',');
    logFile.print(Vp, 3); logFile.print(',');
    logFile.print(Ip, 3); logFile.print(',');
    logFile.print(Pp, 3); logFile.print(',');
    logFile.print(Vbat, 3); logFile.print(',');
    logFile.print(soc, 3); logFile.print(',');
    logFile.print(duty, 3); logFile.print(',');
    logFile.println(throttle, 3);
    logFile.flush();
    logFile.close();
  }
}

