// --- Main setup & loop ---
void startAPMode() {
  WiFi.softAP(AP_SSID, AP_PASS);
  IPAddress IP = WiFi.softAPIP();
  Serial.printf("Started AP mode. Connect to SSID '%s' (password: %s). IP: %s\n", AP_SSID, AP_PASS, IP.toString().c_str());
}

void startStationMode() {
  Serial.printf("Connecting to Wi-Fi SSID '%s'...\n", WIFI_SSID);
  WiFi.begin(WIFI_SSID, WIFI_PASS);
  unsigned long start = millis();
  while (millis() - start < 15000) { // 15s timeout
    if (WiFi.status() == WL_CONNECTED) break;
    delay(200);
  }
  if (WiFi.status() == WL_CONNECTED) {
    Serial.print("Connected. IP: ");
    Serial.println(WiFi.localIP());
  } else {
    Serial.println("Failed to connect to STA. Falling back to AP mode.");
    startAPMode();
  }
}

void setup() {
  Serial.begin(115200);
  delay(100);

  // init I2C for INA219
  Wire.begin(21, 22); // SDA, SCL
  if (!ina_panel.begin()) {
    Serial.println("Failed to find INA219 chip");
    while (1) delay(10);
  }
  ina_panel.setCalibration_32V_2A(); // tune if using higher currents

  // ADC setup
  analogReadResolution(12); // 0..4095
  pinMode(BAT_ADC_PIN, INPUT);

  // PWM (LEDC)
  ledcSetup(MPPT_LEDC_CHANNEL, PWM_FREQ_MPPT, PWM_RES_BITS);
  ledcAttachPin(MPPT_PWM_PIN, MPPT_LEDC_CHANNEL);
  ledcSetup(MOTOR_LEDC_CHANNEL, PWM_FREQ_MOTOR, PWM_RES_BITS);
  ledcAttachPin(MOTOR_PWM_PIN, MOTOR_LEDC_CHANNEL);

  setMpptDuty(mpptDuty);
  setMotorThrottle(0.0);

  // SD init
  sdInitAndHeader();

  // WiFi init: try STA if credentials provided, else AP
  if (strlen(WIFI_SSID) > 0) {
    startStationMode();
    if (WiFi.status() != WL_CONNECTED) {
      // AP already started in startStationMode() fallback
    }
  } else {
    startAPMode();
  }

  // Web server routes
  server.on("/", handleIndex);
  server.on("/telemetry", handleTelemetry);
  server.on("/mppt_log.csv", handleLogDownload);
  server.begin();
  Serial.println("HTTP server started.");

  Serial.println("ESP32 MPPT web UI started.");
}

void loop() {
  unsigned long now = millis();
  server.handleClient(); // handle incoming clients

  // MPPT loop
  if (now - lastMpptMillis >= MPPT_PERIOD) {
    lastMpptMillis = now;

    // Read panel (INA219)
    float Vp = ina_panel.getBusVoltage_V();           // bus voltage sensed (V)
    float Ip_mA = ina_panel.getCurrent_mA();          // mA
    float Ip = Ip_mA / 1000.0;                        // A
    float Pp = Vp * Ip;                               // W

    // Initialize prevPower if first time
    if (prevPower == 0.0) {
      prevPower = Pp;
      prevVoltage = Vp;
    }

    // Perturb & Observe
    float testDuty = mpptDuty + dutyDirection * mpptStep;
    if (testDuty > MPPT_MAX_DUTY) testDuty = MPPT_MAX_DUTY;
    if (testDuty < MPPT_MIN_DUTY) testDuty = MPPT_MIN_DUTY;
    setMpptDuty(testDuty);
    delay(200); // allow converter to settle (tune per hardware)
    // measure again
    float Vp2 = ina_panel.getBusVoltage_V();
    float Ip2 = ina_panel.getCurrent_mA() / 1000.0;
    float Pp2 = Vp2 * Ip2;

    if (Pp2 > Pp) {
      // power increased -> keep direction
      mpptDuty = testDuty;
      prevPower = Pp2;
    } else {
      // power decreased -> reverse direction
      dutyDirection = -dutyDirection;
      mpptDuty = mpptDuty + dutyDirection * mpptStep;
      if (mpptDuty < MPPT_MIN_DUTY) mpptDuty = MPPT_MIN_DUTY;
      if (mpptDuty > MPPT_MAX_DUTY) mpptDuty = MPPT_MAX_DUTY;
      setMpptDuty(mpptDuty);
      delay(50);
      prevPower = ina_panel.getBusVoltage_V() * (ina_panel.getCurrent_mA()/1000.0);
    }

    // For telemetry
    float Vbat = readBatteryVoltage();
    float soc = estimateSOC(Vbat);
    float throttle = 0.25; // example throttle (replace with real input if needed)

    // Update volatile telemetry (atomic-ish)
    telemetry_Vp = Vp2;
    telemetry_Ip = Ip2;
    telemetry_Pp = Pp2;
    telemetry_Vbat = Vbat;
    telemetry_soc = soc;
    telemetry_duty = mpptDuty;
    telemetry_throttle = throttle;
    telemetry_tms = millis();

    Serial.printf("Vp:%.3f V Ip:%.3f A P:%.3f W Vbat:%.3f soc:%.3f duty:%.3f\n", Vp2, Ip2, Pp2, Vbat, soc, mpptDuty);
  }

  // Logging
  if (now - lastLogMillis >= LOG_INTERVAL) {
    lastLogMillis = now;
    float Vp = telemetry_Vp;
    float Ip = telemetry_Ip;
    float Pp = telemetry_Pp;
    float Vbat = telemetry_Vbat;
    float soc = telemetry_soc;
    float duty = telemetry_duty;
    float throttle = telemetry_throttle;
    unsigned long tms = telemetry_tms;
    appendLog(tms, Vp, Ip, Pp, Vbat, soc, duty, throttle);
    // set throttle (apply to motor)
    setMotorThrottle(throttle);
  }

  delay(10);
}
