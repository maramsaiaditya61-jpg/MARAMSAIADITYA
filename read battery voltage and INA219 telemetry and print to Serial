# Simple solar-MPPT-battery-motor simulation (P&O MPPT)
# Requires: numpy, matplotlib
import numpy as np
import matplotlib.pyplot as plt

# simple PV model: Isc and Voc scaling with irradiance G (0..1)
def pv_voltage_current(v, G=1.0, Voc=0.6*36, Isc=5.0): # example panel ~36 cells
    # simplified I-V: I = Isc*G * (1 - exp((v - Voc)/(nVt)))
    nVt = 0.1*Voc
    I = Isc*G * (1 - np.exp((v - Voc)/nVt))
    I[v>=Voc] = 0
    return I

# battery simple model
class Battery:
    def __init__(self, capacity_Ah=2.2, Vnom=7.4):
        self.cap = capacity_Ah
        self.Vnom = Vnom
        self.soc = 0.9
    def apply_current(self, I, dt): # I positive = charging (A), dt in hours
        self.soc += I * dt / self.cap
        self.soc = max(0.01, min(0.99, self.soc))
    def voltage(self):
        return self.Vnom * (0.9 + 0.2*(self.soc-0.5)) # crude

# simulate MPPT P&O
dt = 1.0/60/60 # 1 second in hours
T = 3600 # simulate 1 hour (3600 sec)
times = np.arange(0, T)
G_profile = 0.8 + 0.2*np.sin(np.linspace(0, 6*np.pi, T)) # varying irradiance
battery = Battery(2.2, 7.4)
duty = 0.5
step = 0.02
hist = {'power':[], 'duty':[], 'Vpv':[], 'Ipv':[], 'soc':[]}

for t in range(T):
    G = max(0.05, G_profile[t])
    # approximate converter: Vpv = Vpanel * (1 - duty*0.5) crude mapping
    # better: assume converter steps down so Vpv ~ Vbattery / duty  (buck)
    Vbat = battery.voltage()
    Vpv = min(36.0, Vbat / max(0.05, duty)) # crude buck assumption
    # compute panel current from simple model at Vpv
    Ipv = pv_voltage_current(Vpv, G=G, Voc=21, Isc=2.5) # adjust Voc/Isc to panel
    Ppv = Vpv * Ipv
    # perturb & observe every 2s
    if t % 2 == 0:
        testDuty = min(0.95, max(0.05, duty + step))
        Vpv_test = min(36.0, Vbat / max(0.05, testDuty))
        Ipv_test = pv_voltage_current(Vpv_test, G=G, Voc=21, Isc=2.5)
        Ptest = Vpv_test * Ipv_test
        if Ptest > Ppv:
            duty = testDuty
        else:
            duty = max(0.05, duty - step)
    # power delivered to battery approx Ppv
    battery.apply_current(Ppv / battery.Vnom, dt)
    hist['power'].append(Ppv)
    hist['duty'].append(duty)
    hist['Vpv'].append(Vpv)
    hist['Ipv'].append(Ipv)
    hist['soc'].append(battery.soc)

# plots
plt.figure(figsize=(10,6))
plt.subplot(3,1,1)
plt.plot(hist['power']); plt.ylabel('Ppv (W)')
plt.subplot(3,1,2)
plt.plot(hist['duty']); plt.ylabel('Duty')
plt.subplot(3,1,3)
plt.plot(hist['soc']); plt.ylabel('Battery SOC')
plt.xlabel('seconds')
plt.tight_layout()
plt.show()

