// MPPT controller (Perturb & Observe) for solar-assisted RC car
// Requires: Adafruit_INA219 library
#include <Wire.h>
#include <Adafruit_INA219.h>

Adafruit_INA219 ina_panel;   // measure panel voltage/current
Adafruit_INA219 ina_batt;    // optional: measure battery voltage/current (or use ADC)
const int pwmPin = 5;        // PWM to control converter gate (via driver)
const int motorPwmPin = 6;   // motor throttle PWM (via motor driver)
float duty = 0.5;            // 0..1 initial duty for converter
const float step = 0.02;     // perturbation step
float prevPower = 0.0;
unsigned long lastMPPT = 0;
const unsigned long MPPT_PERIOD = 800; // ms

void setPWMduty(float d) {
  if (d < 0.05) d = 0.05;
  if (d > 0.95) d = 0.95;
  int out = (int)(d * 255.0);
  analogWrite(pwmPin, out);
}

void setup() {
  Serial.begin(115200);
  ina_panel.begin();
  // ina_batt.begin(); // optional battery monitor if installed
  pinMode(pwmPin, OUTPUT);
  pinMode(motorPwmPin, OUTPUT);
  analogWrite(pwmPin, (int)(duty*255));
  analogWrite(motorPwmPin, 0);
  delay(200);
}

void loop() {
  unsigned long now = millis();
  if (now - lastMPPT >= MPPT_PERIOD) {
    lastMPPT = now;
    // read panel
    float Vp = ina_panel.getBusVoltage_V();
    float Ip = ina_panel.getCurrent_mA() / 1000.0;
    float Pp = Vp * Ip;

    // first-time initialization
    if (prevPower <= 0.0001) {
      prevPower = Pp;
    }

    // try perturbing up
    float testDuty = duty + step;
    if (testDuty > 0.95) testDuty = 0.95;
    setPWMduty(testDuty);
    delay(250); // let converter settle
    float Vp2 = ina_panel.getBusVoltage_V();
    float Ip2 = ina_panel.getCurrent_mA() / 1000.0;
    float Pp2 = Vp2 * Ip2;

    if (Pp2 > Pp) {
      // keep direction (increase)
      duty = testDuty;
      prevPower = Pp2;
    } else {
      // reverse direction
      duty = duty - step;
      if (duty < 0.05) duty = 0.05;
      setPWMduty(duty);
      delay(100);
      float Vp3 = ina_panel.getBusVoltage_V();
      float Ip3 = ina_panel.getCurrent_mA() / 1000.0;
      prevPower = Vp3 * Ip3;
    }

    // telemetry
    Serial.print("Vp:"); Serial.print(Vp2); Serial.print(" V, ");
    Serial.print("Ip:"); Serial.print(Ip2); Serial.print(" A, ");
    Serial.print("Pp:"); Serial.print(Pp2); Serial.print(" W, ");
    Serial.print("duty:"); Serial.println(duty);
  }

  // Motor control (example throttle control)
  int throttle = analogRead(A1) / 4; // read a potentiometer or remote control
  analogWrite(motorPwmPin, throttle);

  // Keep loop responsive
  delay(10);
}
