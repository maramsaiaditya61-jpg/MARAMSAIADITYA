/*
  name=esp32_mppt_sd_logger.ino

  ESP32 Solar MPPT (Perturb & Observe) + Motor Control + INA219 telemetry + SD CSV logging

  Dependencies:
   - Adafruit INA219 library
   - SPI, SD (Arduino core for ESP32)

  Target hardware:
   - ESP32 (Arduino core)
   - INA219 I2C current/voltage sensor (panel side)
   - Off-the-shelf adjustable buck/MPPT module controlled by PWM input (gate driver)
   - 2S LiPo battery (7.4V) with BMS
   - Motor driver (accepts PWM throttle from ESP32)
   - SD card module (SPI)

  Wiring/pin mapping is below in the README section.
*/

#include <Wire.h>
#include <Adafruit_INA219.h>
#include <SPI.h>
#include <SD.h>

// === CONFIGURATION ===

// I2C (INA219)
Adafruit_INA219 ina_panel;

// ADC battery sense (voltage divider to ADC pin)
const int BAT_ADC_PIN = 35; // ADC1_CH7 (input-only)
const float R1 = 100000.0;  // top resistor (ohms)
const float R2 = 33000.0;   // bottom resistor (ohms); choose such that Vbat_max maps < 3.3V
const float ADC_REF_V = 3.3; // ADC reference
const int ADC_MAX = 4095;    // 12-bit ADC for ESP32 (0..4095) by default

// SD card SPI pins (standard ESP32 SPI)
const int SD_CS = 5;   // chip select for SD card
const int SD_MOSI = 23;
const int SD_MISO = 19;
const int SD_SCK = 18;

// PWM / LEDC for MPPT converter control and motor throttle
const int MPPT_PWM_PIN = 25;   // PWM to converter/gate driver
const int MOTOR_PWM_PIN = 26;  // PWM to motor driver

const int MPPT_LEDC_CHANNEL = 0;
const int MOTOR_LEDC_CHANNEL = 1;
const int PWM_FREQ_MPPT = 20000; // 20 kHz for power converter gate input (tune per module)
const int PWM_FREQ_MOTOR = 5000; // 5 kHz for motor driver
const int PWM_RES_BITS = 10;     // 10-bit resolution (0..1023)
const int PWM_MAX = (1 << PWM_RES_BITS) - 1;

// MPPT parameters
float mpptDuty = 0.5; // 0..1 initial duty
const float MPPT_MIN_DUTY = 0.05;
const float MPPT_MAX_DUTY = 0.95;
float mpptStep = 0.02;   // step size for perturb & observe (tune)
unsigned long MPPT_PERIOD = 800; // ms between MPPT iterations (tune)

// Logging
unsigned long LOG_INTERVAL = 1000; // ms
File logFile;
const char *LOG_FILE_NAME = "/mppt_log.csv";

// Telemetry smoothing
const int SMOOTH_N = 4;

// === END CONFIG ===

unsigned long lastMpptMillis = 0;
unsigned long lastLogMillis = 0;
float prevPower = 0.0;
float prevVoltage = 0.0;
float dutyDirection = 1.0; // +1 = increase, -1 = decrease

// Helper: set MPPT duty (0..1)
void setMpptDuty(float d) {
  if (d < MPPT_MIN_DUTY) d = MPPT_MIN_DUTY;
  if (d > MPPT_MAX_DUTY) d = MPPT_MAX_DUTY;
  mpptDuty = d;
  int pwmVal = (int)(mpptDuty * PWM_MAX);
  ledcWrite(MPPT_LEDC_CHANNEL, pwmVal);
}

// Helper: set motor throttle (0..1)
void setMotorThrottle(float t) {
  if (t < 0.0) t = 0.0;
  if (t > 1.0) t = 1.0;
  int pwmVal = (int)(t * PWM_MAX);
  ledcWrite(MOTOR_LEDC_CHANNEL, pwmVal);
}

// read battery voltage via ADC and divider
float readBatteryVoltage() {
  uint16_t raw = analogRead(BAT_ADC_PIN);
  float vAdc = (float)raw / ADC_MAX * ADC_REF_V;
  float vBat = vAdc * (R1 + R2) / R2;
  return vBat;
}

// Rough coulomb-free SOC estimate from voltage for 2S LiPo (approx)
float estimateSOC(float vBat) {
  // 2S nominal 7.4V: per-cell approx map (this is approximate for LiPo)
  float perCellV = vBat / 2.0;
  // Map 3.2V -> 0%, 3.7V -> 50%, 4.2V -> 100%
  float soc = (perCellV - 3.2) / (4.2 - 3.2);
  if (soc < 0) soc = 0;
  if (soc > 1) soc = 1;
  return soc;
}

void sdInitAndHeader() {
  SPI.begin(SD_SCK, SD_MISO, SD_MOSI, SD_CS);
  if (!SD.begin(SD_CS)) {
    Serial.println("SD begin failed!");
    return;
  }
  // create file and header if not exists
  if (!SD.exists(LOG_FILE_NAME)) {
    logFile = SD.open(LOG_FILE_NAME, FILE_WRITE);
    if (logFile) {
      logFile.println("timestamp_ms,Vpanel(V),Ipanel(A),Ppanel(W),Vbat(V),soc,duty,throttle");
      logFile.flush();
      logFile.close();
    }
  }
}

void appendLog(unsigned long tms, float Vp, float Ip, float Pp, float Vbat, float soc, float duty, float throttle) {
  if (!SD.begin(SD_CS)) {
    // do nothing if SD fails (avoid spamming)
    return;
  }
  logFile = SD.open(LOG_FILE_NAME, FILE_APPEND);
  if (logFile) {
    logFile.print(tms); logFile.print(',');
    logFile.print(Vp, 3); logFile.print(',');
    logFile.print(Ip, 3); logFile.print(',');
    logFile.print(Pp, 3); logFile.print(',');
    logFile.print(Vbat, 3); logFile.print(',');
    logFile.print(soc, 3); logFile.print(',');
    logFile.print(duty, 3); logFile.print(',');
    logFile.println(throttle, 3);
    logFile.flush();
    logFile.close();
  }
}

void setup() {
  Serial.begin(115200);
  delay(100);

  // init I2C for INA219
  Wire.begin(21, 22); // SDA, SCL
  if (!ina_panel.begin()) {
    Serial.println("Failed to find INA219 chip");
    while (1) delay(10);
  }
  ina_panel.setCalibration_32V_2A(); // tune if using higher currents

  // ADC setup
  analogReadResolution(12); // 0..4095
  pinMode(BAT_ADC_PIN, INPUT);

  // PWM (LEDC)
  ledcSetup(MPPT_LEDC_CHANNEL, PWM_FREQ_MPPT, PWM_RES_BITS);
  ledcAttachPin(MPPT_PWM_PIN, MPPT_LEDC_CHANNEL);
  ledcSetup(MOTOR_LEDC_CHANNEL, PWM_FREQ_MOTOR, PWM_RES_BITS);
  ledcAttachPin(MOTOR_PWM_PIN, MOTOR_LEDC_CHANNEL);

  setMpptDuty(mpptDuty);
  setMotorThrottle(0.0);

  // SD init
  sdInitAndHeader();

  Serial.println("ESP32 MPPT logger started.");
}

void loop() {
  unsigned long now = millis();

  // MPPT loop
  if (now - lastMpptMillis >= MPPT_PERIOD) {
    lastMpptMillis = now;

    // Read panel (INA219)
    float Vp = ina_panel.getBusVoltage_V();           // bus voltage sensed (V)
    float Ip_mA = ina_panel.getCurrent_mA();          // mA
    float Ip = Ip_mA / 1000.0;                        // A
    float Pp = Vp * Ip;                               // W

    // Initialize prevPower if first time
    if (prevPower == 0.0) {
      prevPower = Pp;
      prevVoltage = Vp;
    }

    // Perturb & Observe
    float testDuty = mpptDuty + dutyDirection * mpptStep;
    if (testDuty > MPPT_MAX_DUTY) testDuty = MPPT_MAX_DUTY;
    if (testDuty < MPPT_MIN_DUTY) testDuty = MPPT_MIN_DUTY;
    setMpptDuty(testDuty);
    delay(200); // allow converter to settle (tune per hardware)
    // measure again
    float Vp2 = ina_panel.getBusVoltage_V();
    float Ip2 = ina_panel.getCurrent_mA() / 1000.0;
    float Pp2 = Vp2 * Ip2;

    if (Pp2 > Pp) {
      // power increased -> keep direction
      mpptDuty = testDuty;
      prevPower = Pp2;
    } else {
      // power decreased -> reverse direction
      dutyDirection = -dutyDirection;
      mpptDuty = mpptDuty + dutyDirection * mpptStep;
      if (mpptDuty < MPPT_MIN_DUTY) mpptDuty = MPPT_MIN_DUTY;
      if (mpptDuty > MPPT_MAX_DUTY) mpptDuty = MPPT_MAX_DUTY;
      setMpptDuty(mpptDuty);
      delay(50);
      prevPower = ina_panel.getBusVoltage_V() * (ina_panel.getCurrent_mA()/1000.0);
    }

    // For telemetry print
    float Vbat = readBatteryVoltage();
    float soc = estimateSOC(Vbat);
    Serial.print("Vp:"); Serial.print(Vp2,3); Serial.print("V ");
    Serial.print("Ip:"); Serial.print(Ip2,3); Serial.print("A ");
    Serial.print("P:"); Serial.print(Pp2,3); Serial.print("W ");
    Serial.print("Vbat:"); Serial.print(Vbat,3); Serial.print("V ");
    Serial.print("soc:"); Serial.print(soc,3); Serial.print(" ");
    Serial.print("duty:"); Serial.println(mpptDuty,3);
  }

  // Logging
  if (now - lastLogMillis >= LOG_INTERVAL) {
    lastLogMillis = now;
    float Vp = ina_panel.getBusVoltage_V();
    float Ip = ina_panel.getCurrent_mA() / 1000.0;
    float Pp = Vp * Ip;
    float Vbat = readBatteryVoltage();
    float soc = estimateSOC(Vbat);
    float duty = mpptDuty;
    // throttle example: set from a potentiometer if wired, else 0.2
    float throttle = 0.25; // change/integrate input reading as needed
    setMotorThrottle(throttle);

    unsigned long tms = millis();
    appendLog(tms, Vp, Ip, Pp, Vbat, soc, duty, throttle);
  }

  // Keep loop responsive
  delay(10);
}
